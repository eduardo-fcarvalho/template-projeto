{
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Read(/.env)",
      "Read(~/.ssh/**)",
      "Edit(/scripts/guardrails/**)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/guardrails/guardrails.py claude"
          }
        ]
      }
    ]
  }
}
